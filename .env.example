# ---------------------------------------------------------------
# Copy to .env  (cp .env.example .env)  and NEVER commit .env
# ---------------------------------------------------------------

# FREE Groq API key: https://console.groq.com/keys
# (sign in, click "Create API Key". No credit card required.)
GROQ_API_KEY=

# Check current free models at https://console.groq.com/docs/models
LLM_MODEL=openai/gpt-oss-20b

# Runs locally on CPU. Downloaded once (~90 MB), then works offline.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Security & limits
MAX_UPLOAD_MB=15
RATE_LIMIT_CHAT=15/minute
RATE_LIMIT_UPLOAD=6/minute
# Comma-separated list of origins allowed by CORS. Set to your real domain in production.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Retrieval tuning (raise MIN_RELEVANCE for stricter "I don't know" behaviour)
MIN_RELEVANCE=0.20
TOP_K=5

# Exposes /api/docs when true. Keep false in production.
DEBUG=false